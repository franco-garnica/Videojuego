
class Mapa {
  int escala = 50;

  int[][] paredes = {
    {1, 1, 1, 6},
    {4, 1, 1, 6},
    {7, 1, 1, 4},
    {10, 1, 1, 4},
    {13, 1, 1, 6},
    {7, 6, 1, 1},
    {10, 6, 1, 1},
    {1, 8, 4, 1},
    {7, 8, 4, 3},
    {12, 8, 3, 1},
    {1, 10, 1, 5},
    {4, 10, 1, 4},
    {13, 10, 1, 5},
    {7, 12, 4, 3}
  };

  PImage metal, ladrillo, vegetacion;

  Mapa() {
    metal = loadImage("metal.png");
    ladrillo = loadImage("ladrillo.png");
    vegetacion = loadImage("vegetacion.png");
  }

  void mostrar() {
    imageMode(CORNER);

    for (int i = 0; i < paredes.length; i++) {
      int px = paredes[i][0] * escala;
      int py = paredes[i][1] * escala;
      int ancho = paredes[i][2] * escala;
      int alto = paredes[i][3] * escala;

      // Elegir la textura según el grupo
      PImage textura;

      if (i % 3 == 0) {
        textura = metal;
      } else if (i % 3 == 1) {
        textura = ladrillo;
      } else {
        textura = vegetacion;
      }

      // Repetir la imagen en cada casilla
      for (int x = px; x < px + ancho; x += escala) {
        for (int y = py; y < py + alto; y += escala) {
          image(textura, x, y, escala, escala);
        }
      }
    }
  }

  boolean colisiona(float x, float y, float anchoTanque, float altoTanque) {
    for (int i = 0; i < paredes.length; i++) {
      float px = paredes[i][0] * escala;
      float py = paredes[i][1] * escala;
      float ancho = paredes[i][2] * escala;
      float alto = paredes[i][3] * escala;

      if (x + anchoTanque / 2 > px &&
          x - anchoTanque / 2 < px + ancho &&
          y + altoTanque / 2 > py &&
          y - altoTanque / 2 < py + alto) {
        return true;
      }
    }

    return false;
  }
}
