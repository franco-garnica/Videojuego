int estadoJuego = 0;

Menu menu;
Mapa mapa;
Tanque1 tanque1;
Torreta torreta;

PImage imagenTanque1;
PImage imagenPasto;

void setup() {
  size(800, 800);

  // Imagen del tanque
  imagenTanque1 = loadImage("tanque1.png");

  // Imagen del pasto
  imagenPasto = loadImage("pasto.png");

  menu = new Menu();
  mapa = new Mapa();

  tanque1 = new Tanque1(600, 600);

  // La torreta pertenece al tanque
  torreta = new Torreta(tanque1);
}

void draw() {

  if (estadoJuego == 0) {

    menu.mostrar();

  } else if (estadoJuego == 1) {

    // Dibujamos el fondo
    dibujarFondo();

    // Dibujamos el mapa
    mapa.mostrar();

    // Movemos el tanque
    tanque1.mover();

    // Movemos la torreta hacia el mouse
    torreta.mover();

    // Primero el chasis
    tanque1.mostrar();

    // Después la torreta
    torreta.mostrar();
  }
}

void dibujarFondo() {

  imageMode(CORNER);

  for (int x = 0; x < width; x += imagenPasto.width) {
    for (int y = 0; y < height; y += imagenPasto.height) {
      image(imagenPasto, x, y);
    }
  }
}

void mousePressed() {

  if (estadoJuego == 0) {
    menu.comprobarBoton();
  }
}